{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "name": "${mod_name}",
    "version": "${mod_version}",
    "description": "Adds in a load of customization to a few native UI elements such as the bossbar, scoreboard, etc.",
    "icon": "assets/tgvanillahud/icon.png",
    "authors": [
        "TG"
    ],
    "contact": {
        "homepage": "https://github.com/ShadowGamerIND37/OneLauncher/tree/mods/vanillahud",
        "sources": "https://github.com/ShadowGamerIND37/OneLauncher/tree/mods/vanillahud"
    },
    "license": "GPL-3.0",
    "environment": "client",
    "entrypoints": {
        "client": [
            {
                "value": "org.tg.tgvanillahud.TGVanillaHUDClient",
                "adapter": "kotlin"
            }
        ]
    },
    "mixins": [
        "mixins.tgvanillahud.soundfix.json",
        "mixins.tgvanillahud.json"
    ],
    "depends": {
        "minecraft": "${minecraft_version_range}",
        "fabricloader": ">=${loader_version}",
        "fabric-api": "*",
        "tgoneconfigv1": ">=${tgoneconfig_version}",
        "polycompose": ">=${polycompose_version}"
    },
    "suggests": {
        "soundfix": ">=1.2.0"
    }
}
