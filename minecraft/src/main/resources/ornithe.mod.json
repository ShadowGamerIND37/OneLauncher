{
  "schemaVersion": 1,
  "id": "tgoneconfig",
  "provides": [
    "tgoneconfigv1",
    "tgoneconfigbootstrap"
  ],
  "name": "TG OneConfig",
  "version": "${mod_version}",
  "description": "Access all your mod settings in one place, with a sleek and intuitive interface.",
  "authors": [
    "TG"
  ],
  "contact": {
    "homepage": "https://github.com/ShadowGamerIND37",
    "sources": "https://github.com/ShadowGamerIND37/OneLauncher/tree/mods/tgoneconfig",
    "issues": "https://inv.wtf/polyfrost"
  },
  "icon": "tgoneconfig-icon.png",
  "license": "LGPL-3.0",
  "environment": "client",
  "accessWidener": "tgoneconfigv1.classtweaker",
  "mixins": [
    "mixins.tgoneconfigv1.init.json",
    "mixins.tgoneconfigv1.json"
  ],
  "entrypoints": {
    "client": [
      "org.tg.tgoneconfig.internal.TGOneConfig"
    ],
    "preLaunch": [
      "org.tg.tgoneconfig.internal.TGOneConfigPreLaunch"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${fabric_mc_version}",
    "pylon": ">=0.2.4",
    "osl-core": ">=0.10.0",
    "osl-config": ">=0.6.2",
    "osl-localization": ">=0.1.1",
    "osl-networking": ">=0.10.0",
    "osl-resource-loader": ">=0.8.0",
    "osl-text-components": ">=0.1.0-alpha.5",
    "fabric-language-kotlin": ">=${flk_version}",
    "polycompose": ">=${polycompose_version}"
  },
  "breaks": {
    "chattweaks": "<1.2.3",
    "crashpatch": "<2.2.3",
    "evergreenhud": "<3.9.13",
    "polydium": "<1.2.0",
    "polyplus": "<1.4.0"
  }
}
